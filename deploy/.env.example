# QISU HUB 运行环境
# 复制为 .env 后按需修改；权限建议 chmod 600，不要提交进仓库。

# ---- 基础 ----
PORT=8080
QISUSHUO_DATA=/var/lib/qisu

# 未登录一律 401，生产必须为 1
QISUSHUO_REQUIRE_LOGIN=1

# ---- 首个管理员（首次启动写入 credentials 表；改这里会重置该账号密码）----
QISUSHUO_ADMIN_USER=jiahao
QISUSHUO_ADMIN_PASSWORD=请替换为强密码

# ---- 专家邀请码（可选；写入 expert_codes 表后即可发给外部专家）----
# 留空则不创建。空间 ID 可在管理员登录后的「空间设置」底部看到。
QISUSHUO_EXPERT_CODE=
QISUSHUO_EXPERT_SPACE=
QISUSHUO_EXPERT_ROLE=expert
QISUSHUO_EXPERT_LABEL=

# ---- 安全 ----
# 经 HTTPS 反代时设为 1：旧版 /api/join 换发的 Cookie 会带 Secure。
# 登录接口无需此项，它自己看 X-Forwarded-Proto。
QISUSHUO_SECURE_COOKIE=1

# 开发期把验证码显示在页面上；生产必须删除或设为 0
# QISUSHUO_DEV_CODE=0
